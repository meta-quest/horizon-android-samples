# Build outputs + local tooling state for this React Native sample. Patterns have no
# leading slash so they also match
# the nested Gradle root under android/ (android/app/build, android/.gradle, ...).
# Local builds regenerate everything here, so none of it is committed.

# Gradle
.gradle/
build/
local.properties

# Native (NDK / CMake / prefab)
.cxx/

# Kotlin
.kotlin/

# React Native / Node (a partner's `yarn install` populates these)
node_modules/

# npm registry pointer. Building inside Meta needs one (public npm is blocked --
# see README.md), but it names an internal host, so it must never ship to a
# partner. Keep it local, or set the registry globally in ~/.npmrc instead.
.npmrc

# Bundle embedded by `react-native bundle` for an untethered (no Metro) install.
# A stale embedded bundle silently shadows Metro.
android/app/src/main/assets/index.android.bundle

# Local Maven repository, if one is ever created or symlinked here.
.gruck/
.gruck

# IDE
.idea/
*.iml

# OS
.DS_Store
