<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-variant resource: `src/debug/res/` is not on the release variant's resource path, so a
     release build cannot reference this file even by accident.

     No <base-config>, so the platform default for targetSdk 28+ applies to everything not listed
     below: cleartext denied. The three hosts here cover the documented dev loop — the loopback pair
     when `adb reverse tcp:8081 tcp:8081` forwards the dev server onto the device (the way this
     sample's README builds and runs it, and the way `react-native run-android` sets it up), and
     10.0.2.2 for the emulator's alias of the host machine.

     Serving Metro on a LAN address instead (starting it with an explicit host, plus "Change bundle
     location" in the dev menu) is the one dev path this does NOT cover: the connection is refused
     as cleartext, which surfaces as a bundle-download failure rather than as a security error.
     There is no wildcard or CIDR form in this file, so add the machine explicitly, like the
     commented line below. `adb reverse` works over wireless adb too and needs no edit, so prefer
     it.

     Note for editors: XML forbids a double hyphen inside a comment, and aapt2 fails the build on
     one. Spell command-line flags out in prose here. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- <domain includeSubdomains="false">192.168.1.42</domain> -->
    </domain-config>
</network-security-config>
